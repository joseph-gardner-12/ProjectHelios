# Optional local PostgreSQL/Redis: copy to .env and load with uv run --env-file.
# Omit POSTGRES_HOST and REDIS_URL to keep SQLite and an in-memory channel layer.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=helios
POSTGRES_USER=helios
POSTGRES_PASSWORD=local-only-change-me
REDIS_URL=redis://127.0.0.1:6379/0

# Production additionally requires these (bootstrap creates the real server file).
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_SECRET_KEY=generate-a-unique-secret-with-at-least-50-characters
# DJANGO_ALLOWED_HOSTS=api.projecthelios.dev
# DJANGO_FRONTEND_ORIGINS=https://www.projecthelios.dev,https://projecthelios.dev

# Required for control (health endpoints still work without these).
CONTROL_DEMO_DEVICE_ID=
# Generate with Django make_password; single-quote the value to preserve dollar signs.
CONTROL_PASSWORD_HASH=
CONTROL_REDIS_PREFIX=helios:control:v1
