{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Helios Pi protocol v1",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "version",
        "type",
        "device_id",
        "connection_id",
        "timestamp",
        "frame_version",
        "telemetry_hz"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "setup"
        },
        "device_id": {
          "type": "string",
          "format": "uuid"
        },
        "connection_id": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "frame_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "telemetry_hz": {
          "const": 5
        }
      }
    },
    {
      "type": "object",
      "required": [
        "version",
        "type",
        "device_id",
        "connection_id",
        "timestamp",
        "frame_version"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "ready"
        },
        "device_id": {
          "type": "string",
          "format": "uuid"
        },
        "connection_id": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "frame_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "capability": {
          "enum": [
            "dummy",
            "measurement"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "version",
        "type",
        "device_id",
        "connection_id",
        "timestamp",
        "frame_version"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "heartbeat"
        },
        "device_id": {
          "type": "string",
          "format": "uuid"
        },
        "connection_id": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "frame_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    {
      "type": "object",
      "required": [
        "version",
        "type",
        "device_id",
        "connection_id",
        "timestamp",
        "frame_version",
        "command_id",
        "expires_at",
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "target"
        },
        "device_id": {
          "type": "string",
          "format": "uuid"
        },
        "connection_id": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "frame_version": {
          "const": "dummy-enu-v1"
        },
        "command_id": {
          "type": "string",
          "format": "uuid"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "target": {
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 3.048
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 3.048
            },
            "z": {
              "type": "number",
              "minimum": 0,
              "maximum": 3.048
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "version",
        "type",
        "device_id",
        "connection_id",
        "timestamp",
        "frame_version",
        "command_id",
        "accepted"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "ack"
        },
        "device_id": {
          "type": "string",
          "format": "uuid"
        },
        "connection_id": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "frame_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "command_id": {
          "type": "string",
          "format": "uuid"
        },
        "accepted": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "version",
        "type",
        "device_id",
        "connection_id",
        "timestamp",
        "frame_version",
        "command_id"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "arrival"
        },
        "device_id": {
          "type": "string",
          "format": "uuid"
        },
        "connection_id": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "frame_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "command_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "version",
        "type",
        "device_id",
        "connection_id",
        "timestamp",
        "frame_version",
        "position",
        "source",
        "state",
        "sequence"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "position"
        },
        "device_id": {
          "type": "string",
          "format": "uuid"
        },
        "connection_id": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "frame_version": {
          "const": "dummy-enu-v1"
        },
        "position": {
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 3.048
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 3.048
            },
            "z": {
              "type": "number",
              "minimum": 0,
              "maximum": 3.048
            }
          }
        },
        "source": {
          "const": "dummy"
        },
        "state": {
          "enum": [
            "idle",
            "moving"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "command_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "completed_command_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "simulated_localization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frame",
            "observation"
          ],
          "properties": {
            "frame": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "observation": {
              "$ref": "#/$defs/observation"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "version",
        "type",
        "code",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "error"
        },
        "code": {
          "enum": [
            "machine_already_connected",
            "backend_unavailable"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    {
      "type": "object",
      "required": [
        "version",
        "type",
        "device_id",
        "connection_id",
        "timestamp",
        "frame_version",
        "sequence",
        "source",
        "observation"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "observation"
        },
        "device_id": {
          "type": "string",
          "format": "uuid"
        },
        "connection_id": {
          "type": "string",
          "format": "uuid"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "frame_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "not": {
            "const": "dummy-enu-v1"
          }
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "enum": [
            "uwb",
            "synthetic"
          ]
        },
        "observation": {
          "$ref": "#/$defs/observation"
        }
      }
    }
  ],
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "session",
        "estimated_time",
        "measurement_time",
        "prediction_age_s",
        "position",
        "covariance",
        "timing_sigma_s",
        "reason"
      ],
      "properties": {
        "kind": {
          "enum": [
            "measured",
            "predicted",
            "invalid"
          ]
        },
        "session": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "estimated_time": {
          "type": "string",
          "format": "date-time"
        },
        "measurement_time": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "prediction_age_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "position": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "x",
                "y",
                "z"
              ],
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "covariance": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "timing_sigma_s": {
          "type": "number",
          "minimum": 0
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "invalid"
              }
            }
          },
          "then": {
            "properties": {
              "position": {
                "type": "null"
              },
              "covariance": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "position": {
                "type": "object",
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                }
              },
              "measurement_time": {
                "type": "string",
                "format": "date-time"
              },
              "prediction_age_s": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.100001
              },
              "covariance": {
                "type": "array"
              },
              "reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "measured"
              }
            }
          },
          "then": {
            "properties": {
              "prediction_age_s": {
                "const": 0
              }
            }
          }
        }
      ]
    }
  }
}
